# Copy to .env.local — values are the public (anon) keys, safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BACKEND_URL=

# Google Sign-In (web) — the SAME OAuth *Web client ID* the app uses as
# GOOGLE_WEB_CLIENT_ID. Public (not a secret). Its "Authorized JavaScript
# origins" in Google Cloud Console must include http://localhost:3000 and your
# production domain (e.g. https://taeam.ca), or the Google button errors.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Stripe PUBLISHABLE keys (pk_test_... / pk_live_...), safe for the browser.
# REQUIRED for checkout: with these blank the payment form cannot load and
# every order dead-ends at the pay step. Which one is used follows the
# stripe_mode row in app_config (see src/lib/stripe-mode.ts).
NEXT_PUBLIC_STRIPE_PK_TEST=
NEXT_PUBLIC_STRIPE_PK_LIVE=
